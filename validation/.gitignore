# Downloaded datasets, dependency caches and build products stay local.
.cache/
.venv/
.pytest_cache/
node_modules/
_build/
deps/
target/
datasets/
*.parquet
*.arrow
*.sqlite*

# Raw captures and generated results. Keep source, lock files and Markdown reports.
*.json
*.jsonl
*.log
*.txt
*.gz
*.png
*.jpg
*.wav
*.pcm
*.bin

# Tool configuration and reusable fixtures are part of the checkout.
!package.json
!package-lock.json
!requirements.txt
!CMakeLists.txt
!**/fixtures/**
!**/fixtures.json
!**/cases.json
!**/contextual-cases.json

# Compact, intentional reports and the release comparison baseline.
!*summary.json
!/release/baseline.json
!/release/qualification.json
!/release/review.json

